# Notion Integration Token
NOTION_TOKEN=

# Notion 数据库 ID（4 个独立库）
NOTION_ARTICLES_DATABASE_ID=
NOTION_WORDS_DATABASE_ID=
NOTION_SHARE_DATABASE_ID=
NOTION_COOKING_DATABASE_ID=

# 说说发布 API 密钥（Authorization: Bearer <PUBLISH_SECRET>）
PUBLISH_SECRET=

# 发布说说后触发 Vercel 部署（可选，不填则只写 Notion 不触发重建）
VERCEL_DEPLOY_HOOK=

# 站点绝对 URL（RSS / sitemap / metadataBase 使用，生产必须设置）
NEXT_PUBLIC_SITE_URL=

# 增量同步开关：设为 true 时忽略 sync-state 强制全量重拉（等同 pnpm fetchAll --force），平时留空
# FORCE_SYNC=true
